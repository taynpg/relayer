# ---- 构建目录 ----
/build*/
/out/
cmake-build-*/

# ---- 编译产物 ----
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.d
*.ninja
.ninja_deps
.ninja_log
compile_commands.json
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json

# ---- Qt 生成物 ----
moc_*.cpp
qrc_*.cpp
ui_*.h
*.moc
.qmake.stash
# 注意：不要忽略 *.ui —— 那是手写的界面描述，必须入仓

# ---- IDE ----
.vscode/
.idea/
*.user
*.sln
*.vcxproj*
.cache/
.clangd/

# ---- 运行时 ----
*.relaypart
*.log
relayer-archive-*.tar.xz
crash-*.dmp

# ---- 其他 ----
.DS_Store
Thumbs.db

# ---- Python（e2e 测试脚本）----
__pycache__/
*.py[cod]

# ---- 编辑器/工具本地状态 ----
# cmk 是本机 CMake 前端的配置与临时状态，含本机绝对路径
.cmk/
